{
  "info": {
    "name": "StoneAI API",
    "_postman_id": "stoneai-collection-2026",
    "description": "Complete API collection for StoneAI Backend — Auth + Minerals endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rutuja Sawant\",\n  \"email\": \"rutuja@gmail.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://192.168.0.107:5000/api/auth/register",
              "protocol": "http",
              "host": ["192", "168", "0", "107"],
              "port": "5000",
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user. Returns JWT token + user info."
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rutuja@gmail.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://192.168.0.107:5000/api/auth/login",
              "protocol": "http",
              "host": ["192", "168", "0", "107"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            },
            "description": "Login with email and password. Returns JWT token."
          }
        },
        {
          "name": "Get My Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "description": "Paste your JWT token here" }
            ],
            "url": {
              "raw": "http://192.168.0.107:5000/api/auth/profile",
              "protocol": "http",
              "host": ["192", "168", "0", "107"],
              "port": "5000",
              "path": ["api", "auth", "profile"]
            },
            "description": "Protected route. Requires Bearer token in Authorization header."
          }
        }
      ]
    },
